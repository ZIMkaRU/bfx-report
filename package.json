{
  "name": "@bitfinex/bfx-report",
  "version": "5.5.0",
  "description": "Reporting tool",
  "main": "worker.js",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "contributors": [
    "Vladimir Voronkov <vsvoronkov@gmail.com>",
    "Paolo Ardoino <paolo@btifinex.com>",
    "Ezequiel Wernicke <ezequiel.wernicke@bitfinex.com>"
  ],
  "dependencies": {
    "@bitfinex/bfx-facs-deflate": "git+https://github.com/bitfinexcom/bfx-facs-deflate.git#v2.0.0",
    "@bitfinex/bfx-facs-grc-slack": "git+https://github.com/bitfinexcom/bfx-facs-grc-slack.git#v2.0.0",
    "@bitfinex/bfx-facs-lokue": "git+https://github.com/bitfinexcom/bfx-facs-lokue.git#v2.0.0",
    "@bitfinex/bfx-svc-boot-js": "git+https://github.com/bitfinexcom/bfx-svc-boot-js.git#v2.0.0",
    "@bitfinex/bfx-wrk-api": "git+https://github.com/bitfinexcom/bfx-wrk-api.git#v2.0.0",
    "@bitfinex/lib-js-util-base": "git+https://github.com/bitfinexcom/lib-js-util-base.git#v3.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "async": "^3.2.6",
    "bitfinex-api-node": "^10.0.0",
    "colors": "1.4.0",
    "csv-stringify": "6.9.0",
    "i18next": "27.1.1",
    "i18next-fs-backend": "2.6.12",
    "inversify": "7.11.0",
    "lru": "3.1.0",
    "moment": "2.31.0",
    "moment-timezone": "0.6.6",
    "pug": "3.0.4",
    "reflect-metadata": "0.2.2",
    "triple-beam": "1.4.1",
    "winston": "3.19.0",
    "winston-transport": "4.9.0",
    "yargs": "17.7.3"
  },
  "devDependencies": {
    "@bitfinex/bfx-report-express": "git+https://github.com/bitfinexcom/bfx-report-express.git",
    "@bitfinex/lint-js": "^1.1.0",
    "bfx-api-mock-srv": "^4.0.0",
    "chai": "4.3.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "grenache-grape": "^2.0.1",
    "mocha": "11.1.0",
    "nodemon": "3.1.14",
    "supertest": "7.1.0"
  },
  "nodemonConfig": {
    "verbose": true,
    "ignore": [
      "test/",
      "db/",
      "node_modules/",
      "logs/",
      ".git/",
      ".idea/",
      ".vscode/",
      "csv/",
      "workers/loc.api/queue/temp/"
    ]
  },
  "scripts": {
    "start": "concurrently -ki -c cyan,green,blue -n ENV,WORKER,SERVER \"npm run startSimulEnv\" \"node -e 'setTimeout(()=>{},3000)' && npm run startDev\" \"npm run startServDev\"",
    "startDev": "cross-env NODE_ENV=development nodemon worker.js --env=development --wtype=wrk-report-service-api --apiPort 1337 --dbId 1",
    "startServDev": "cross-env NODE_ENV=development NODE_CONFIG_DIR=./test/config node ./node_modules/@bitfinex/bfx-report-express",
    "startSimulEnv": "cross-env NODE_ENV=development node test/simulate/simulate-enviroment.js",
    "test": "npm run lint && npm run unit && cross-env NODE_ENV=test mocha './test/**/*.spec.js' --config .mocharc.json",
    "testDev": "cross-env NODE_ENV=test mocha './workers/**/__test__/*-dev.spec.js' './test/**/*-dev.spec.js' --config .mocharc.json",
    "unit": "cross-env NODE_ENV=test mocha './workers/**/__test__/*.spec.js' --config .mocharc.json",
    "lint": "bfx-lint-js",
    "lint:fix": "bfx-lint-js --fix"
  }
}
